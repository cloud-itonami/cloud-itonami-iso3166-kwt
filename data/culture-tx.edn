#:culture{:id "kwt.dish.machboos", :name "Machboos (kabsa)", :country "KWT", :kind :dish, :summary "Arab mixed rice dish of rice, meat, vegetables and aromatic spices; commonly regarded as a national dish in all Gulf Cooperation Council countries and listed as a national symbol of Kuwait, where it is known as machboos.", :url "https://en.wikipedia.org/wiki/Kabsa", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "kwt.dish.mutabbaq-samak", :name "Mutabbaq samak", :country "KWT", :kind :dish, :summary "Rice-based dish of spiced fried fish and caramelized onions served over rice cooked in spiced fish stock; considered a national dish in Iraq and Kuwait.", :url "https://en.wikipedia.org/wiki/Mutabbaq_samak", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "kwt.dish.harees", :name "Harees", :country "KWT", :kind :dish, :summary "Dish of boiled cracked wheat mixed with meat, spices and butter, commonly eaten in Arab states of the Persian Gulf during Ramadan; its know-how was inscribed as UNESCO intangible cultural heritage in 2023 by Kuwait among other Gulf states.", :url "https://en.wikipedia.org/wiki/Harees", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "kwt.dish.murabyan", :name "Murabyan", :country "KWT", :kind :dish, :summary "Kuwaiti dish of rice cooked with either fresh or dried shrimp.", :url "https://en.wikipedia.org/wiki/Kuwaiti_cuisine", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "kwt.dish.gers-ogaily", :name "Gers ogaily", :country "KWT", :kind :dish, :summary "Traditional Kuwaiti cake made with eggs, flour, sugar, cardamom and saffron, traditionally served with tea.", :url "https://en.wikipedia.org/wiki/Kuwaiti_cuisine", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "kwt.craft.al-sadu", :name "Al Sadu weaving", :country "KWT", :kind :craft, :summary "Traditional Bedouin craft of weaving geometric patterns on a ground loom; Sadu House in Kuwait was established in 1980, and traditional Al Sadu weaving in Kuwait and Saudi Arabia was inscribed by UNESCO as intangible cultural heritage in 2020.", :url "https://en.wikipedia.org/wiki/Al_Sadu", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "kwt.craft.dhow", :name "Dhow", :country "KWT", :kind :craft, :summary "Traditional sailing vessel of the Red Sea and Indian Ocean; Kuwait's Al-Hashemi-II is recognized by Guinness World Records as the largest wooden dhow ever built, and the Kuwaiti Maritime Museum in Salmiya holds replicas of many dhow types.", :url "https://en.wikipedia.org/wiki/Dhow", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "kwt.festival.hala-febrayer", :name "Hala Febrayer", :country "KWT", :kind :festival, :summary "Month-long festival commemorating the liberation of Kuwait, running from 1 to 28 February with music concerts, parades and carnivals; Liberation Day itself is celebrated on 26 February.", :url "https://en.wikipedia.org/wiki/Kuwait", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "kwt.heritage.failaka-island", :name "Failaka Island", :country "KWT", :kind :heritage, :summary "Kuwaiti island in the Persian Gulf about 20 km off Kuwait City, inhabited since antiquity with archaeological evidence of Dilmun, Mesopotamian and Hellenistic Greek settlement (the Greeks called it Ikaros).", :url "https://en.wikipedia.org/wiki/Failaka_Island", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
]
